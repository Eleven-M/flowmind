{
  "name": "flowmind",
  "version": "2.0.2",
  "description": "Memory and workflow automation for MCP, Codex, and Claude Code. Reuse repeatable developer operations through skills and explicit feedback.",
  "type": "commonjs",
  "main": "core/index.js",
  "bin": {
    "flowmind": "./bin/flowmind.js",
    "flowmind-codex": "./bin/flowmind-codex.js",
    "flowmind-mcp": "./mcp/server.js"
  },
  "scripts": {
    "start": "node core/index.js",
    "mcp": "node mcp/server.js",
    "check:update": "node scripts/check-update.js",
    "test": "node --no-warnings ./node_modules/jest/bin/jest.js",
    "test:coverage": "node --no-warnings ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check --ignore-unknown package.json eslint.config.cjs .eslintrc.json .prettierrc.json .madgerc core/automation-chain.js core/knowledge-deposition.js core/release-check.js core/secure-files.js core/task-store.js core/upgrade-status.js scripts/package-check.js __tests__/upgrade-directions.test.js",
    "deps:graph": "madge --circular --extensions js,jsx bin core mcp skills tui dashboard",
    "package:check": "node scripts/package-check.js",
    "release-check": "node scripts/package-check.js",
    "audit:prod": "npm audit --omit=dev",
    "quality": "npm run lint && npm run format:check && npm run deps:graph && npm run package:check && npm test -- --runInBand",
    "build": "webpack --mode production",
    "dev": "nodemon core/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "claude-code",
    "ai-agent",
    "developer-tools",
    "cli",
    "workflow-automation",
    "developer-productivity",
    "memory-layer",
    "skill-routing",
    "log-analysis",
    "code-review",
    "devops",
    "mcp-server"
  ],
  "author": "FlowMind Technologies",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eleven-M/flowmind.git"
  },
  "bugs": {
    "url": "https://github.com/Eleven-M/flowmind/issues"
  },
  "homepage": "https://github.com/Eleven-M/flowmind#readme",
  "files": [
    "bin/",
    "core/",
    "mcp/",
    "skills/",
    "tui/",
    "dashboard/",
    "demo/flowmind-demo.gif",
    "scripts/check-update.js",
    "config/",
    "docs/",
    "releases/",
    "README.md",
    "README_CN.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.0.0",
    "fs-extra": "^11.1.1",
    "ink": "^3.2.0",
    "ink-spinner": "^4.0.3",
    "ink-text-input": "^4.0.3",
    "inquirer": "^8.2.6",
    "lru-cache": "^7.18.3",
    "ora": "^5.4.1",
    "p-limit": "^3.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "execa": "^5.1.1",
    "jest": "^30.4.2",
    "madge": "^8.0.0",
    "nodemon": "^3.0.1",
    "npm-packlist": "^10.0.4",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "strip-ansi": "^6.0.1",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "minimatch": "10.2.5"
  }
}
